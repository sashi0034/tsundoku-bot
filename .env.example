# Slack Bot Token (xoxb-...)
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxx

# Slack App-Level Token for Socket Mode (xapp-...)
SLACK_APP_TOKEN=xapp-xxxxxxxxxx

# Canvas ID (Slack Canvas のファイルID, Fxxxxxxxx 形式)
CANVAS_ID=Fxxxxxxxxxx

# チェック済みURLを投稿するスレッドの親メッセージが属するチャンネルID
THREAD_CHANNEL_ID=Cxxxxxxxxxx

# チェック済みURLを投稿するスレッドの親メッセージのタイムスタンプ
THREAD_TS=1234567890.123456

# (任意) メッセージを監視するチャンネルIDをカンマ区切りで指定
# 空の場合はBotが参加している全チャンネルを監視
WATCH_CHANNEL_IDS=
